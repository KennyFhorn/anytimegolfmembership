# Supabase — create a project at https://supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only secret, used only by the Stripe webhook. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use test keys until you're ready to go live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave all of the above unset to run the app in demo mode with sample data.
